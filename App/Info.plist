<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- The name the menu bar and About show: "Queen Bee Dev" in a Debug build. PRODUCT_NAME stays QueenBee so paths don't change. -->
	<key>CFBundleName</key>
	<string>$(QB_BUNDLE_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>$(QB_BUNDLE_NAME)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.developer-tools</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Updates: Sparkle reads the feed, and only installs a download signed with the key below. -->
	<key>SUFeedURL</key>
	<string>https://raw.githubusercontent.com/bamboozledkitty/queen-bee/main/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>yY7DQmoNMLvc0wlsV3MUWNmagTIZ2hTFZG9RoZZA8RQ=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- Remote: a paired iPad or iPhone finds this Mac on the local network. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Queen Bee uses your local network so an iPad or iPhone you paired can show your flows.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_queenbee._tcp</string>
		<string>_queenbee-pair._tcp</string>
	</array>
	<!-- queenbee://run?flow=…&message=… starts a run, once the person says yes to it in the app. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Queen Bee run link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>queenbee</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
